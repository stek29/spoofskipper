#!/usr/bin/env python3
"""Rehearse the documented rollback using preloaded old/new images, no egress."""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT / 'sing-box/manager'))
from spoofskipper_manager.compiler import edited_source
from spoofskipper_manager.subscriptions import Providers
from spoofskipper_manager.state import atomic_write


def docker(*args, **kwargs):
    return subprocess.run(['docker', *args], check=True, capture_output=True, **kwargs).stdout


def wait(predicate):
    for _ in range(100):
        try:
            if predicate():
                return
        except subprocess.CalledProcessError:
            pass
        time.sleep(.1)
    raise AssertionError('rollback condition timed out')


with tempfile.TemporaryDirectory(prefix='manager-rollback-') as temp:
    root = Path(temp)
    # Restore both release inputs, just as the operator runbook requires.
    legacy_ref = os.environ.get('MANAGER_LEGACY_REF', 'b03a046')
    for filename in ('docker-compose.yml', '.env'):
        restored = subprocess.run(['git', 'show', f'{legacy_ref}:{filename}'],
                                  cwd=ROOT, check=True, capture_output=True).stdout
        (root / filename).write_bytes(restored)
    restored = json.loads(docker('compose', '--env-file', str(root / '.env'),
        '-f', str(root / 'docker-compose.yml'), 'config', '--format', 'json'))
    legacy_service = restored['services']['sing-tun']
    assert legacy_service['command'] == ['run', '-c', '/tmp/sing.json']
    assert legacy_service['image'].endswith('-1'), 'restore the pre-cutover image version'
    config, data = root / 'config', root / 'data'
    shutil.copytree(Path(__file__).parent / 'fixtures', config)
    data.mkdir()
    original = (config / 'config.jsonnet').read_text()
    (config / 'config.jsonnet.legacy').write_text(original)
    (config / 'config.jsonnet').write_text(edited_source(original))
    (config / 'provider.txt').write_text('trojan://synthetic@127.0.0.1:1#one\n')
    specs = {'subscriptions': [{'prefix': 'example', 'url': 'file:///config/provider.txt',
                               'tag_template': '{prefix}_{name}', 'group_template': '{prefix}'}]}
    (config / 'local-subs-config.json').write_text(json.dumps(specs))
    provider = Providers(config, data, {}, lambda *a, **k: None)
    output = {'outbounds': [{'type': 'trojan', 'tag': 'example_one', 'server': '127.0.0.1',
                            'server_port': 1, 'password': 'synthetic'}], 'groups': {'example': ['example_one']}}
    provider.commit({'example': {'provider': 'example', 'fetched_at': time.time(), 'output': output}})
    name = 'spoofskipper-stage1-rollback-' + str(os.getpid())
    volumes = ['-v', f'{config}:/config:ro', '-v', f'{data}:/data']
    try:
        docker('run', '-d', '--name', name, '--network', 'none', '--user', str(os.getuid()),
               '--read-only', '--tmpfs', '/tmp', *volumes, 'spoofskipper-manager:stage3')
        wait(lambda: b'activation_succeeded' in docker('logs', name))
        docker('stop', '-t', '3', name)
        assert docker('inspect', '-f', '{{.State.ExitCode}}', name).strip() == b'0'
        docker('rm', name)
        # Manager scheduler is stopped. Restore the legacy template and run the
        # exact legacy refresh once, writing only its local-subs.json output.
        # Restore inside Docker's filesystem view (Docker Desktop can retain
        # a bind-mounted file's old length after a host-side replacement).
        docker('run', '--rm', '--network', 'none', '--user', str(os.getuid()),
               '-v', f'{config}:/config', '--entrypoint', 'python3', '-e', 'PYTHONPATH=/opt/manager',
               'spoofskipper-manager:stage3', '-c',
               'from pathlib import Path; from spoofskipper_manager.state import atomic_write; '
               'atomic_write(Path("/config/config.jsonnet"), Path("/config/config.jsonnet.legacy").read_bytes())')
        local_specs = {'subscriptions': [{**specs['subscriptions'][0], 'url': (config / 'provider.txt').as_uri()}]}
        refresh_specs = root / 'legacy-refresh.json'
        refresh_specs.write_text(json.dumps(local_specs))
        result = subprocess.run([sys.executable, str(ROOT / 'sing-subs/merge-subs.py'), str(refresh_specs)],
                                check=True, capture_output=True)
        (config / 'local-subs.json').write_bytes(result.stdout)
        before = {p.relative_to(data): hashlib.sha256(p.read_bytes()).digest() for p in data.rglob('*') if p.is_file()}
        observed = docker('run', '--rm', '--network', 'none', '--entrypoint', '/bin/cat', *volumes,
                      'spoofskipper-legacy:stage1', '/config/config.jsonnet')
        assert observed == original.encode(), 'restored template differs'
        # Only isolate mounts/network/privileges and substitute the preloaded
        # legacy image. The command comes from the restored release Compose file.
        rehearsal = root / 'rollback-compose.json'
        rehearsal.write_text(json.dumps({'services': {'legacy': {
            'image': 'spoofskipper-legacy:stage1', 'command': legacy_service['command'],
            'container_name': name, 'network_mode': 'none', 'user': str(os.getuid()),
            'read_only': True, 'tmpfs': ['/tmp'],
            'environment': {'CONFIG_TMPL': '/config/sing.jsonnet'},
            'volumes': [f'{config}:/config:ro', f'{data}:/data']}}}))
        docker('compose', '-p', name, '-f', str(rehearsal), 'up', '-d', '--pull', 'never')
        wait(lambda: docker('inspect', '-f', '{{.State.Running}}', name).strip() == b'true')
        # Wait for rendering/startup, then inspect the actual core API from the
        # baseline container's network namespace using the preloaded new image.
        wait(lambda: docker('exec', name, '/bin/sh', '-c', '[ -s /tmp/sing.json ]') == b'')
        docker('run', '--rm', '--network', 'container:' + name, '--entrypoint', 'python3',
               'spoofskipper-manager:stage3', '-c',
               'import json,time,urllib.request\n'
               'for _ in range(50):\n'
               ' try:\n'
               '  req=urllib.request.Request("http://127.0.0.1:19090/proxies",headers={"Authorization":"Bearer synthetic-test-secret"})\n'
               '  data=json.load(urllib.request.urlopen(req,timeout=1))["proxies"]\n'
               '  assert "example_one" in data and not any(t.startswith("__spoofskipper_revision_") for t in data)\n'
               '  break\n'
               ' except OSError: time.sleep(.1)\n'
               'else: raise SystemExit(1)')
        after = {p.relative_to(data): hashlib.sha256(p.read_bytes()).digest() for p in data.rglob('*') if p.is_file()}
        assert before == after, 'legacy image touched manager state'
        docker('stop', '-t', '3', name)
        assert docker('inspect', '-f', '{{.State.ExitCode}}', name).strip() == b'0'
        print('Rollback rehearsal passed: manager stopped, legacy template restored, legacy refresh once, old image verified on same /data.')
    except BaseException:
        result = subprocess.run(['docker', 'logs', name], capture_output=True)
        print((result.stdout + result.stderr).decode(), file=sys.stderr)
        raise
    finally:
        subprocess.run(['docker', 'rm', '-f', name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
