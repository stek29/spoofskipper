#!/usr/sbin/nft -f
# vim: set expandtab ts=2 sw=2 ai

flush ruleset

include "/config/nftables.nft"

table inet zapret2 {
  # nat64 is tayga: its ipv6 leg is skipped, nfqws2 only sees the translated ipv4 on the wire
  chain postnat {
    type filter hook postrouting priority srcnat + 1; policy accept;

    oifname != { lo, nat64 } tcp dport $TCP_PORTS ct original packets 1-$TCP_PKT_OUT meta mark & $DESYNC_MARK == 0x00000000 counter meta mark set meta mark | $DESYNC_MARK_POSTNAT queue flags bypass to $NFQ_NUM
    oifname != { lo, nat64 } udp dport $UDP_PORTS ct original packets 1-$UDP_PKT_OUT meta mark & $DESYNC_MARK == 0x00000000 counter meta mark set meta mark | $DESYNC_MARK_POSTNAT queue flags bypass to $NFQ_NUM
    oifname != { lo, nat64 } tcp dport $TCP_PORTS tcp flags & (fin | rst) != 0 meta mark & $DESYNC_MARK == 0x00000000 counter meta mark set meta mark | $DESYNC_MARK_POSTNAT queue flags bypass to $NFQ_NUM comment "fin/rst for conntrack"
  }

  chain prerouting {
    type filter hook prerouting priority dstnat + 1; policy accept;
  }

  chain prenat {
    type filter hook prerouting priority dstnat - 1; policy accept;

    iifname != { lo, nat64 } tcp sport $TCP_PORTS ct reply packets 1-$TCP_PKT_IN queue flags bypass to $NFQ_NUM
    iifname != { lo, nat64 } udp sport $UDP_PORTS ct reply packets 1-$UDP_PKT_IN queue flags bypass to $NFQ_NUM
    iifname != { lo, nat64 } tcp sport $TCP_PORTS tcp flags & (fin | rst) != 0 queue flags bypass to $NFQ_NUM comment "fin/rst for conntrack"
  }

  chain predefrag {
    type filter hook output priority -401; policy accept;
    meta mark & $DESYNC_MARK == $DESYNC_MARK jump predefrag_nfqws comment "nfqws2 generated : avoid drop by INVALID conntrack state"
  }

  chain predefrag_nfqws {
    meta mark & $DESYNC_MARK_POSTNAT == $DESYNC_MARK_POSTNAT notrack comment "postnat traffic"
    ip frag-off & 0x1fff != 0 notrack comment "ipfrag"
    exthdr frag exists notrack comment "ipfrag"
    tcp flags ! syn,rst,ack notrack comment "datanoack"
  }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        ip saddr $TAYGA_POOL4 counter masquerade

        # masquerade everything to avoid routing loops
        meta oif != lo counter masquerade
    }
}
